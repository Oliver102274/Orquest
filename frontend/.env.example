VITE_API_BASE_URL=http://localhost:8000

# Copy to frontend/.env.local; this example is not loaded automatically.
# Public SPA configuration only. Never put keys, passwords, or DATABASE_URL here.
VITE_AUTH0_ENABLED=false
VITE_AUTH0_DOMAIN=
# Client ID from Orquest (Single Page Application), not the API test client.
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://api.orquest.app
