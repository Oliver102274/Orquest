# The application reads process environment variables, not this file automatically.
# Provider adapters are explicit backend calls; current endpoints never call them.
# Never put real credentials in this example or commit local .env files.
GEMINI_API_KEY=
SWARMS_API_KEY=
PRUNE_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Never confirm for a billed Gemini project. No request-level free-tier switch exists.
GEMINI_FREE_TIER_CONFIRMED=false
DATABASE_URL=
# Keep false until the value above has been replaced with newly rotated credentials.
# DB helper reads process variables only; never paste a connection URL into commands.
DATABASE_CREDENTIALS_ROTATED=false
# Opt-in local MDC overlay; requires a catalog containing its linked career ID.
ORQUESTRA_MDC_DEMO_ENABLED=false

# Disabled by default. Enable only after live-request approval and account setup.
ORQUESTRA_AI_ENABLED=false
AI_MAX_REQUESTS_PER_PROVIDER=0
AI_MAX_INPUT_CHARS=12000
AI_MAX_OUTPUT_TOKENS=1024
AI_TIMEOUT_SECONDS=30

# Select supported models intentionally after checking account access and pricing.
# Prune requires a provider credential saved in its vault as well as PRUNE_API_KEY.
GEMINI_MODEL=
SWARMS_MODEL=
PRUNE_MODEL=

# Exact allowed browser origin. No cookies/authentication are implemented yet.
FRONTEND_ORIGIN=http://localhost:5173

# Optional JSON directory; defaults to the repository's data folder.
# Relative paths resolve from the server's working directory.
ORQUESTRA_DATA_DIR=
